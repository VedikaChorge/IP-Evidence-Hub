FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,txt,doc,docx,zip,py,js,html,css,svg

# Application mode label. Supported labels: coral-testnet, mainnet, local
MST_NETWORK=coral-testnet

# MST Coral Testnet (preferred new testnet; verify current RPC before use)
MST_CORAL_RPC_URL=https://coralrpc.mstblockchain.com
MST_CORAL_CHAIN_ID=54635
MST_CORAL_EXPLORER=https://coral.mstscan.com

# MST Mainnet
MST_MAINNET_RPC_URL=https://4646.rpc.thirdweb.com
MST_MAINNET_CHAIN_ID=4646
MST_MAINNET_EXPLORER=https://mstscan.com

# Optional server-side transaction signer. Do not commit private keys.
MST_PRIVATE_KEY=
IP_EVIDENCE_CONTRACT_ADDRESS=

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
DATABASE_PATH=ip_evidence.db
